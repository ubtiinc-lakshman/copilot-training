diff --git a/src/orders/discount.js b/src/orders/discount.js
index 3f1a2b4..9c8d7e6 100644
--- a/src/orders/discount.js
+++ b/src/orders/discount.js
@@ -1,6 +1,9 @@
-function applyDiscount(total, code) {
-  if (code === "SAVE10") return total * 0.9;
-  return total;
-}
+const CODES = { SAVE10: 0.1, SAVE25: 0.25 };
+
+function applyDiscount(total, code) {
+  const rate = CODES[code];
+  if (rate === undefined) return total;
+  return Math.round(total * (1 - rate));
+}

-module.exports = { applyDiscount };
+module.exports = { applyDiscount, CODES };
