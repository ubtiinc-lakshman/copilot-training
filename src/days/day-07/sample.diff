diff --git a/src/auth/resetToken.js b/src/auth/resetToken.js
index 3f2a1c4..9b7d0e2 100644
--- a/src/auth/resetToken.js
+++ b/src/auth/resetToken.js
@@ -1,12 +1,25 @@
 const crypto = require("node:crypto");

+const TOKEN_TTL_MS = 30 * 60 * 1000;
+
 function createResetToken(userId) {
-  return { userId, token: crypto.randomBytes(16).toString("hex") };
+  return {
+    userId,
+    token: crypto.randomBytes(16).toString("hex"),
+    expiresAt: Date.now() + TOKEN_TTL_MS,
+    used: false,
+  };
 }

-function isValidToken(record, token) {
-  return record.token === token;
+function isValidToken(record, token, now = Date.now()) {
+  if (!record || record.used) return false;
+  if (now > record.expiresAt) return false;
+  return crypto.timingSafeEqual(Buffer.from(record.token), Buffer.from(token));
 }

-module.exports = { createResetToken, isValidToken };
+function markUsed(record) {
+  record.used = true;
+}
+
+module.exports = { createResetToken, isValidToken, markUsed };
